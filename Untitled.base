views:
  - type: cards
    name: Scripture Study
    filters:
      and:
        - file.hasTag("Scriptures")
    order:
      - file.name
      - file.ctime
      - tags
  - type: table
    name: Biology
    filters:
      and:
        - file.inFolder("School/2. Specialized Subjects/Biology Notes")
    order:
      - file.name
    sort:
      - property: file.basename
        direction: ASC
    cardSize: 260
